# ============================================================================
# SEEN JEEM x GIMNIM — ENVIRONMENT VARIABLES (.env.local)
# ============================================================================

# 1. Supabase Configuration (Primary Backend & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Appwrite Configuration (Optional Alternative Backend Adapter)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=seen_jeem_db

# 3. Stripe Billing & Webhooks Configuration
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# 4. Gemini AI
GEMINI_API_KEY=AIzaSyYourKeyHere...